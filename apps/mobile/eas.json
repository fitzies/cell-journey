{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://limitless-bear-586.convex.cloud"
      }
    },
    "play-testing": {
      "extends": "preview",
      "distribution": "store",
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "play-testing": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6785403977"
      }
    }
  }
}
