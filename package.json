{
  "name": "cell-journey",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "theme:sync": "node packages/theme/scripts/generate-mobile-theme.mjs",
    "dev": "pnpm theme:sync && pnpm --filter mobile start",
    "dev:web": "pnpm theme:sync && pnpm --filter web dev",
    "build": "echo \"No production build configured yet\"",
    "lint": "pnpm theme:sync && pnpm --filter mobile lint",
    "test": "vitest run",
    "typecheck": "pnpm theme:sync && pnpm --filter mobile exec tsc --noEmit --pretty false && pnpm exec tsc -p convex/tsconfig.json --noEmit --pretty false && pnpm --filter web exec tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@cell-journey/domain": "workspace:*",
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "@oslojs/crypto": "^1.0.1",
    "convex": "^1.39.1",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^20",
    "convex-test": "^0.0.54",
    "vitest": "^4.1.10"
  }
}
